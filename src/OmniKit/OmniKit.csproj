<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Name>OmniKit</Name>
    <Punchline>Your everyday toolkit for XIV.</Punchline>
    <Description>A searchable game launcher and optional camera-directed interaction assistant, with native Umbra integration.</Description>
    <Tags>search;utility;accessibility;umbra</Tags>
    <RepoUrl>https://github.com/fostot/OmniKit</RepoUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PathMap>$(MSBuildProjectDirectory)=/src/OmniKit</PathMap>
    <DebugType>none</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <Content Include="../../assets/*.png" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/*.frames.json" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/lunar-walk-rigs.json" Link="assets/lunar-walk-rigs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

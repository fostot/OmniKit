<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OmniKit.Umbra</AssemblyName>
    <AssemblyTitle>OmniKit for Umbra</AssemblyTitle>
    <Description>Native Umbra toolbar access to OmniKit.</Description>
    <Version>0.1.0-dev.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-dev.1</InformationalVersion>
    <IsPackable>false</IsPackable>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src/OmniKit.Umbra</PathMap>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UmbraVersion Condition="'$(UmbraVersion)' == ''">3.1.18.0</UmbraVersion>
    <UmbraLibPath Condition="'$(UmbraLibPath)' == ''">$(APPDATA)/XIVLauncher/installedPlugins/Umbra/$(UmbraVersion)</UmbraLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Umbra" HintPath="$(UmbraLibPath)/Umbra.dll" Private="false" />
    <Reference Include="Umbra.Common" HintPath="$(UmbraLibPath)/Umbra.Common.dll" Private="false" />
    <Reference Include="Una.Drawing" HintPath="$(UmbraLibPath)/Una.Drawing.dll" Private="false" />
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)/Dalamud.dll" Private="false" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)/Lumina.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckUmbraReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UmbraLibPath)/Umbra.dll')"
           Text="Umbra reference assemblies were not found. Install the supported Umbra version or set the UmbraLibPath build property." />
    <Error Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')"
           Text="Dalamud reference assemblies were not found. Set the DalamudLibPath build property." />
  </Target>
</Project>

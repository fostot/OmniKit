<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OmniKit/Ui/CompanionHomeStyleLibrary.cs" Link="CompanionHomeStyleLibrary.cs" />
    <Compile Include="../../src/OmniKit/Ui/CompanionStyleSelection.cs" Link="CompanionStyleSelection.cs" />
    <Compile Include="../../src/OmniKit/Ui/CompanionStyleRenderer.cs" Link="CompanionStyleRenderer.cs" />
    <Compile Include="../../src/OmniKit/Ui/CompanionNapArtwork.cs" Link="CompanionNapArtwork.cs" />
    <Compile Include="../LauncherUiSmoke/SoftwareRenderer.cs" Link="SoftwareRenderer.cs" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll" />
    <Reference Include="HexaGen.Runtime" HintPath="$(DalamudLibPath)/HexaGen.Runtime.dll" />
    <Content Include="$(DalamudLibPath)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

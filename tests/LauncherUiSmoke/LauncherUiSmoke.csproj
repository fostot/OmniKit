<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OmniKit/Ui/CompactLauncher.cs" Link="Source/CompactLauncher.cs" />
    <Compile Include="../../src/OmniKit/Ui/LauncherAppearanceUi.cs" Link="Source/LauncherAppearanceUi.cs" />
    <Compile Include="../../src/OmniKit/Ui/UiText.cs" Link="Source/UiText.cs" />
    <Compile Include="../../src/OmniKit/Search/SearchEngine.cs" Link="Source/SearchEngine.cs" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll" />
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)/Dalamud.dll" />
    <Reference Include="HexaGen.Runtime" HintPath="$(DalamudLibPath)/HexaGen.Runtime.dll" />
    <Content Include="$(DalamudLibPath)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
